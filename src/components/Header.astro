---
import { site } from '../data/site';
const { active = '' } = Astro.props;
const nav = [
  { href: '/', label: 'Home', key: 'home' },
  { href: '/about/', label: 'About', key: 'about' },
  { href: '/publications/', label: 'Publications', key: 'publications' },
  { href: '/teaching/', label: 'Teaching', key: 'teaching' },
  { href: '/posts/', label: 'Posts', key: 'posts' },
  { href: '/cv/', label: 'CV', key: 'cv' }
];
---
<header class="site-header">
  <div class="container nav-shell">
    <a class="brand" href="/" aria-label="Corey Voller home">
      <span class="brand-mark">CV</span>
      <span class="brand-copy">
        <strong>{site.name}</strong>
        <span>Statistics · trials · visualisation</span>
      </span>
    </a>

    <nav class="nav-links" aria-label="Main navigation">
      {nav.map((item) => (
        <a href={item.href} class:list={[active === item.key && 'active']}>{item.label}</a>
      ))}
    </nav>

    <a class="header-button" href={site.cv}>Download CV</a>
  </div>
</header>
