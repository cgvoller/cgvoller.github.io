---
import { timeline } from '../data/site';
---
<div class="timeline">
  {timeline.map((item) => (
    <article class="timeline-item">
      <span>{item.date}</span>
      <div>
        <h3>{item.role}</h3>
        <p class="level">{item.organisation}</p>
        <p>{item.description}</p>
      </div>
    </article>
  ))}
</div>
