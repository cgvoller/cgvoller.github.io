---
import SocialButtons from './SocialButtons.astro';
---
<section class="hero-section">
  <div class="container hero-grid">
    <div class="hero-copy reveal visible">
      <span class="eyebrow">Personal website · statistics · clinical trials</span>
      <h1>Corey Voller</h1>
      <p class="lead">
        Statistician and PhD researcher interested in Bayesian adaptive clinical trial designs, small population trials, medical statistics, R, simulation and interactive visualisation.
      </p>
      <SocialButtons />
      <div class="hero-stats" aria-label="Research and background summary">
        <article class="stat-card">
          <strong>PhD</strong>
          <span>Statistics, University of Bath</span>
        </article>
        <article class="stat-card">
          <strong>R</strong>
          <span>Simulation, reporting and reproducible workflows</span>
        </article>
        <article class="stat-card">
          <strong>Trials</strong>
          <span>Bayesian, adaptive, pragmatic and medical research settings</span>
        </article>
      </div>
    </div>
  </div>
</section>
