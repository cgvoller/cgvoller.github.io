---
import { site } from '../data/site';
const { compact = false } = Astro.props;
---
<div class:list={['social-buttons', compact && 'compact']}>
  </a>
  <a href={site.links.github} class="button button-secondary" target="_blank" rel="noopener noreferrer" aria-label="GitHub profile">
    <i class="fa-brands fa-github" aria-hidden="true"></i>
    <span>GitHub</span>
  </a>
  <a href={site.links.linkedin} class="button button-secondary" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn profile">
    <i class="fa-brands fa-linkedin" aria-hidden="true"></i>
    <span>LinkedIn</span>
  </a>
  <a href={site.links.scholar} class="button button-secondary" target="_blank" rel="noopener noreferrer" aria-label="Google Scholar profile">
    <i class="fa-solid fa-graduation-cap" aria-hidden="true"></i>
    <span>Scholar</span>
  </a>
</div>
