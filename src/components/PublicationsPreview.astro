---
import { publications } from '../data/site';
---

<section class="section reveal">
  <div class="container">
    <div class="section-heading split-heading">
      <div>
        <span class="eyebrow">Publications</span>
        <h2>Published research and statistical applications.</h2>
      </div>
      <a class="text-link" href="/publications/">View all publications →</a>
    </div>
   <div class="publication-flip-hint" aria-hidden="true">
  <span class="publication-flip-hint-text">Click a card to flip</span>

  <svg
    class="publication-flip-arrow"
    width="78"
    height="44"
    viewBox="0 0 78 44"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
  >
    <path
      d="M4 8 C 28 4, 54 13, 68 34"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-dasharray="4 5"
    />
    <path
      d="M59 33 L69 36 L66 26"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
    />
  </svg>
</div>
    <div class="card-grid publication-grid">
      {publications.map((pub) => (
        <article
          class="publication-flip-card"
          data-flip-card
          role="button"
          tabindex="0"
          aria-expanded="false"
          aria-label={`Flip publication card: ${pub.title}`}
        >
          <div class="publication-flip-inner">
            <div class="publication-face publication-front">
              <div class="paper-meta">
                <span>{pub.year}</span>
                <span>{pub.venue}</span>
              </div>

              <h3>{pub.title}</h3>
              <p>{pub.summary}</p>

              <div class="publication-footer">
                <div class="mini-tags">
                  {pub.tags.map((tag) => <span>{tag}</span>)}
                </div>

                <div class="publication-action-row">
                  <a
                    class="text-link publication-doi"
                    href={`https://doi.org/${pub.doi}`}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    doi:{pub.doi}
                  </a>
                </div>
              </div>
            </div>

            <div class="publication-face publication-back">
              <span class="tag">About this paper</span>
              <div class="paper-back-block">
                <strong>Question</strong>
                <p>{pub.back.question}</p>
              </div>

              <div class="paper-back-block">
                <strong>Method</strong>
                <p>{pub.back.method}</p>
              </div>

              <div class="paper-back-block">
                <strong>Contribution</strong>
                <p>{pub.back.contribution}</p>
              </div>

              <div class="publication-back-actions">
                <a
                  class="text-link"
                  href={`https://doi.org/${pub.doi}`}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  Open DOI →
                </a>

                <span class="flip-hint" aria-hidden="true">
                  Back to citation ↺
                </span>
              </div>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<script is:inline>
  const togglePublicationCard = (card) => {
    const isFlipped = card.classList.toggle('is-flipped');
    card.setAttribute('aria-expanded', String(isFlipped));
  };

  document.addEventListener('click', (event) => {
    const target = event.target;
    if (!(target instanceof Element)) return;

    // Keep normal links working: clicking the DOI/Open DOI should not flip the card.
    if (target.closest('a')) return;

    const card = target.closest('[data-flip-card]');
    if (!card) return;

    togglePublicationCard(card);
  });

  document.addEventListener('keydown', (event) => {
    const target = event.target;
    if (!(target instanceof Element)) return;

    const card = target.closest('[data-flip-card]');
    if (!card || target !== card) return;

    if (event.key !== 'Enter' && event.key !== ' ') return;

    event.preventDefault();
    togglePublicationCard(card);
  });
</script>
