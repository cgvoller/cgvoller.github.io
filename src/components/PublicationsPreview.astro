---
import { publications } from '../data/site';
---
<section class="section reveal">
  <div class="container">
    <div class="section-heading split-heading">
      <div>
        <span class="eyebrow">Publications</span>
        <h2>Published research and statistical applications.</h2>
      </div>
      <a class="text-link" href="/publications/">View all publications →</a>
    </div>
    <div class="card-grid publication-grid">
      {publications.map((pub) => (
        <article class="paper-card">
          <div class="paper-meta"><span>{pub.year}</span><span>{pub.venue}</span></div>
          <h3>{pub.title}</h3>
          <p>{pub.summary}</p>
          <div class="mini-tags">{pub.tags.map((tag) => <span>{tag}</span>)}</div>
          <a class="text-link" href={`https://doi.org/${pub.doi}`} target="_blank" rel="noopener noreferrer">doi:{pub.doi}</a>
        </article>
      ))}
    </div>
  </div>
</section>
