---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import ExperienceTimeline from '../components/ExperienceTimeline.astro';
---

<Layout title="CV | Corey Voller" active="cv">
  <PageHero
    eyebrow="CV"
    title="Changelog of my journey"
    lead="Timeline of my education and experience."
  />

  <section class="section paper-section reveal">
    <div class="container">
      <ExperienceTimeline />
    </div>
  </section>

  <section class="section reveal">
  <div class="container contact-panel cv-download">
    <div>
      <span class="tag">CV</span>
      <h2>Full CV available on request.</h2>
      <p>
        This page gives a visual summary of my education, experience and selected skills.
        A full academic CV is available on request.
      </p>
    </div>
  </div>
</section>

  <section class="section reveal">
    <div class="container card-grid">
      <article class="clean-card">
        <h3>Programming</h3>
        <p>R, tidyverse, data.table, ggplot2, RMarkdown/Quarto, Python, SQL and C#.</p>
      </article>
      <article class="clean-card">
        <h3>Software and workflow</h3>
        <p>Git, LaTeX, Microsoft Office, STATA and WinBUGS.</p>
      </article>
      <article class="clean-card">
        <h3>Research interests</h3>
        <p>Bayesian methods, adaptive clinical trials, small populations/rare diseases and evidence synthesis.</p>
      </article>
    </div>
  </section>
</Layout>