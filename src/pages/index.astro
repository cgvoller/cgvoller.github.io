---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import AboutPanel from '../components/AboutPanel.astro';
import ResearchNetwork from '../components/ResearchNetwork.astro';
import PublicationsPreview from '../components/PublicationsPreview.astro';
import TeachingPreview from '../components/TeachingPreview.astro';
import PostsPreview from '../components/PostsPreview.astro';
---
<Layout active="home">
  <Hero />
  <AboutPanel />
  <ResearchNetwork />
  <PublicationsPreview />
  <TeachingPreview />
  <PostsPreview />

  <section class="section contact-band reveal">
  <div class="container contact-panel">
    <div>
      <span class="eyebrow">CV and contact</span>
      <h2>Full CV available on request.</h2>
      <p>
        A visual CV timeline is available on this site. The full academic CV is available on request.
        You can also find my work through GitHub, LinkedIn and Google Scholar.
      </p>
    </div>
    <div class="actions">
      <a class="button button-primary" href="/cv/">View CV timeline</a>
    </div>
  </div>
</section>
</Layout>
